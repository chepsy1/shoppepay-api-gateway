# Copy this file to .env locally and fill in values from your provider.
# Never commit real merchant tokens, API keys, Telegram tokens, chat IDs, or QRIS data.
SHOPEE_TOKEN=replace_with_your_shopee_session_token
API_KEY=replace_with_a_long_random_api_key
PORT=3000
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_your_telegram_chat_id
QRIS_STATIC=replace_with_your_static_qris_payload
